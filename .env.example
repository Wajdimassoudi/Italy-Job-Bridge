# GEMINI_API_KEY: Required for generating personalized email messages.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# GMAIL_USER: Your Gmail address (e.g., example@gmail.com).
GMAIL_USER="YOUR_GMAIL_ADDRESS"

# GMAIL_APP_PASSWORD: An App Password generated from your Google Account settings.
# See: https://support.google.com/accounts/answer/185833
GMAIL_APP_PASSWORD="YOUR_GMAIL_APP_PASSWORD"

# APP_URL: Injected automatically by the environment.
APP_URL="MY_APP_URL"
